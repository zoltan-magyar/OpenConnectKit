# Sources and versions for COpenConnect.xcframework, read by build-xcframework.sh
# and .github/workflows/release.yml. Each can be overridden via the environment.

# OpenSSL release. Find releases at:
# https://github.com/openssl/openssl/releases
OPENSSL_VERSION="${OPENSSL_VERSION:-3.5.8}"
OPENSSL_REPO="${OPENSSL_REPO:-https://github.com/openssl/openssl.git}"

# OpenConnect tag. Until openconnect_set_progress_msg_handler() (MRs !664/!665)
# and openconnect_set_reconnecting_handler() (MR !667) are released upstream,
# this is a `swiftconnect-N` tag on a fork, on top of upstream master. Tags
# there are never moved; bump N for each rebuild.
# Upstream releases: https://gitlab.com/openconnect/openconnect/-/releases
OPENCONNECT_VERSION="${OPENCONNECT_VERSION:-swiftconnect-2}"
OPENCONNECT_REPO="${OPENCONNECT_REPO:-https://gitlab.com/zoltan-magyar/openconnect.git}"
